    // Client-side Python Parser & Simulator
    function runPythonScript() {
      runStatus.textContent = "Executing...";
      runStatus.className = "text-amber-400";
      terminalStdout.innerHTML = "";

      setTimeout(() => {
        try {
          const rawCode = pythonCodeInput.value;
          const outputLines = [];

          // Parse variable definitions and print statements safely
          const lines = rawCode.split("\n");
          let scope = {
            math: Math,
            pi: Math.PI
          };

          for (let line of lines) {
            let trimmed = line.trim();
            if (!trimmed || trimmed.startsWith("#")) continue;

            // Handle print statements
            if (trimmed.startsWith("print(")) {
              let inside = trimmed.slice(6, -1).trim();

              // Handle f-strings or direct strings
              if (inside.startsWith('f"') || inside.startsWith("f'")) {
                let text = inside.slice(2, -1);
                // Replace {var} with evaluated value
                let evaluated = text.replace(/\{([^}]+)\}/g, (match, expr) => {
                  try {
                    let cleanExpr = expr.trim();
                    // Handle format specifiers like :.2f
                    let format = "";
                    if (cleanExpr.includes(":")) {
                      const parts = cleanExpr.split(":");
                      cleanExpr = parts[0];
                      format = parts[1];
                    }
                    let res = evalInScope(cleanExpr, scope);
                    if (format.includes(".1f")) res = Number(res).toFixed(1);
                    else if (format.includes(".2f")) res = Number(res).toFixed(2);
                    else if (format.includes(".3f")) res = Number(res).toFixed(3);
                    else if (format.includes(".4f")) res = Number(res).toFixed(4);
                    else if (format.includes("04X")) res = Number(res).toString(16).toUpperCase().padStart(4, '0');
                    return res;
                  } catch (e) {
                    return `[eval err: ${expr}]`;
                  }
                });
                outputLines.push(evaluated);
              } else if (inside.startsWith('"') || inside.startsWith("'")) {
                outputLines.push(inside.slice(1, -1));
              } else {
                try {
                  outputLines.push(String(evalInScope(inside, scope)));
                } catch(e) {
                  outputLines.push(inside);
                }
              }
            } else if (trimmed.includes("=")) {
              // Variable assignment
              let [varName, expr] = trimmed.split("=").map(s => s.trim());
              if (/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(varName)) {
                try {
                  scope[varName] = evalInScope(expr, scope);
                } catch (e) {
                  // Fallback for objects/dicts
                  try {
                    let sanitizedJson = expr.replace(/'/g, '"');
                    scope[varName] = JSON.parse(sanitizedJson);
                  } catch(err) {
                    // Ignore assignment error in mini parser
                  }
                }
              }
            }
          }

          if (outputLines.length === 0) {
            outputLines.push(">>> Execution completed with no print outputs.");
          }

          outputLines.forEach(line => {
            const p = document.createElement("p");
            p.className = line.startsWith("[✓]") ? "text-cyan-300 font-bold" : "text-emerald-400";
            p.textContent = line;
            terminalStdout.appendChild(p);
          });

          runStatus.textContent = "Success (0)";
          runStatus.className = "text-emerald-400";

        } catch (err) {
          const p = document.createElement("p");
          p.className = "text-rose-400";
          p.textContent = "Execution Error: " + err.message;
          terminalStdout.appendChild(p);
          runStatus.textContent = "Error";
          runStatus.className = "text-rose-400";
        }
      }, 250);
    }

    function evalInScope(expr, scope) {
      // Replace Python exponentiation ** with Math.pow
      let jsExpr = expr.replace(/\*\*/g, "^");
      jsExpr = jsExpr.replace(/math\.pi/g, "Math.PI");
      jsExpr = jsExpr.replace(/int\(/g, "Math.floor(");
      // Replace power expression
      jsExpr = jsExpr.replace(/([0-9a-zA-Z_.]+)\s*\^\s*([0-9a-zA-Z_.]+)/g, "Math.pow($1, $2)");

      const keys = Object.keys(scope);
      const values = Object.values(scope);
      return new Function(...keys, `return (${jsExpr});`)(...values);
    }

