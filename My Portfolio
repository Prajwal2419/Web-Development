    // Tennis Mini Game Implementation inside Canvas
    function initTennisGame() {
      const canvas = document.getElementById("tennisCanvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");

      let paddleHeight = 50;
      let paddleWidth = 8;
      let playerY = (canvas.height - paddleHeight) / 2;
      let aiY = (canvas.height - paddleHeight) / 2;

      let ballX = canvas.width / 2;
      let ballY = canvas.height / 2;
      let ballSpeedX = 4;
      let ballSpeedY = 2.5;
      let ballRadius = 5;

      let playerScore = 0;
      let aiScore = 0;

      // Mouse control
      canvas.addEventListener("mousemove", (evt) => {
        const rect = canvas.getBoundingClientRect();
        const root = document.documentElement;
        const mouseY = evt.clientY - rect.top - root.scrollTop;
        playerY = mouseY - (paddleHeight / 2);
      });

      // Touch control
      canvas.addEventListener("touchmove", (evt) => {
        evt.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touchY = evt.touches[0].clientY - rect.top;
        playerY = touchY - (paddleHeight / 2);
      }, { passive: false });

      function resetBall() {
        ballSpeedX = -ballSpeedX;
        ballSpeedY = (Math.random() - 0.5) * 4;
        ballX = canvas.width / 2;
        ballY = canvas.height / 2;
      }

      function gameLoop() {
        // AI movement tracking
        let aiCenter = aiY + (paddleHeight / 2);
        if (aiCenter < ballY - 18) {
          aiY += 3.2;
        } else if (aiCenter > ballY + 18) {
          aiY -= 3.2;
        }

        // Ball movement
        ballX += ballSpeedX;
        ballY += ballSpeedY;

        // Wall collisions
        if (ballY - ballRadius < 0 || ballY + ballRadius > canvas.height) {
          ballSpeedY = -ballSpeedY;
        }

        // Left paddle collision (Player)
        if (ballX - ballRadius < paddleWidth + 12) {
          if (ballY > playerY && ballY < playerY + paddleHeight) {
            ballSpeedX = Math.abs(ballSpeedX) + 0.2;
            let deltaY = ballY - (playerY + paddleHeight / 2);
            ballSpeedY = deltaY * 0.25;
          } else if (ballX < 0) {
            aiScore++;
            document.getElementById("aiScore").textContent = aiScore;
            resetBall();
          }
        }

        // Right paddle collision (AI)
        if (ballX + ballRadius > canvas.width - paddleWidth - 12) {
          if (ballY > aiY && ballY < aiY + paddleHeight) {
            ballSpeedX = -Math.abs(ballSpeedX) - 0.2;
            let deltaY = ballY - (aiY + paddleHeight / 2);
            ballSpeedY = deltaY * 0.25;
          } else if (ballX > canvas.width) {
            playerScore++;
            document.getElementById("pScore").textContent = playerScore;
            resetBall();
          }
        }

        // Drawing
        ctx.fillStyle = "#020617";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Net
        ctx.strokeStyle = "#1e293b";
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(canvas.width / 2, 0);
        ctx.lineTo(canvas.width / 2, canvas.height);
        ctx.stroke();
        ctx.setLineDash([]);

        // Player Paddle
        ctx.fillStyle = "#06b6d4";
        ctx.fillRect(10, playerY, paddleWidth, paddleHeight);

        // AI Paddle
        ctx.fillStyle = "#818cf8";
        ctx.fillRect(canvas.width - 10 - paddleWidth, aiY, paddleWidth, paddleHeight);

        // Ball
        ctx.fillStyle = "#facc15";
        ctx.beginPath();
        ctx.arc(ballX, ballY, ballRadius, 0, Math.PI * 2);
        ctx.fill();

        liveTennisGameLoop = requestAnimationFrame(gameLoop);
      }

      liveTennisGameLoop = requestAnimationFrame(gameLoop);
    }

