crystal_freq_mhz = 11.0592 # Classic 8051 crystal frequency in MHz

# Standard 8051 takes 12 oscillator periods for 1 machine cycle
osc_period_us = 1.0 / crystal_freq_mhz
machine_cycle_us = 12.0 * osc_period_us

# Timer 0 Delay Count for 1 millisecond overflow (Mode 1 - 16 bit)
target_delay_us = 1000.0
counts_needed = target_delay_us / machine_cycle_us
initial_timer_value = int(65536 - counts_needed)

print("[✓] Microcontroller: 8051 Architecture")
